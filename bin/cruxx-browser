#!/usr/bin/env python3
"""Launcher. Adds the source tree to sys.path when run from a checkout."""

import os
import sys

_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isdir(os.path.join(_root, "cruxx_browser")):
    sys.path.insert(0, _root)

from cruxx_browser.__main__ import main  # noqa: E402

sys.exit(main())
