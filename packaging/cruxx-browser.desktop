[Desktop Entry]
Type=Application
Name=cruxx browser
GenericName=Web Browser
Comment=Small, fast, quiet WebKit browser
Exec=cruxx-browser %U
Icon=cruxx-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=cruxx-browser
StartupNotify=true
Actions=new-private;

[Desktop Action new-private]
Name=New private tab
Exec=cruxx-browser --private
